# Synergy configuration. Copy to .env and adjust: `cp .env.example .env`
# .env is git-ignored. Never commit real secrets.
# Format: plain KEY=value lines (no quotes, no `export`) so both the shell and
# the Makefile can read them.

# --- HTTP server ---
# Phase 1 has no authentication: keep the default loopback bind unless you
# understand the exposure. The server logs a warning when bound elsewhere.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# How long in-flight requests get to finish on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json (production) | text (human-friendly local dev)
LOG_FORMAT=text

# --- PostgreSQL ---
# `make db-setup` creates the role and databases and writes both URLs below
# into .env with a generated password. Required.
DATABASE_URL=postgres://synergy:CHANGE_ME@localhost:5432/synergy?sslmode=disable
# Used only by integration tests; the database name must end in _test.
TEST_DATABASE_URL=postgres://synergy:CHANGE_ME@localhost:5432/synergy_test?sslmode=disable
# Connection pool tuning (defaults shown).
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# --- Ingestion ---
# Upper bound for one fetch of one source (all its requests). Runs left
# "running" by a crashed process are recovered after this plus ~2 minutes.
FETCH_TIMEOUT=2m

# Upstream rate limits are built in, not configured here: Hacker News ~10 req/s,
# arXiv 1 req per 3 s, GitHub 1 search per 6 s (2 s with GITHUB_TOKEN). Per-source
# fetch frequency is each source's min_fetch_interval (see the sources API).

# User-Agent sent to upstream APIs. arXiv appreciates a contact address.
# HTTP_USER_AGENT=Synergy/0.1 (personal AI research aggregator; you@example.com)
# Optional GitHub token (no scopes needed); raises search limits from 10 to
# 30 requests/minute. Never logged.
# GITHUB_TOKEN=

# --- Scheduler (inside `synergy serve`) ---
# Fetch active sources automatically once their min_fetch_interval has passed.
SCHEDULER_ENABLED=true
# How often to check which sources are due (Go duration).
SCHEDULER_INTERVAL=1m

# --- LLM (`synergy summarize`) ---
# Optional Claude API key; without it only `--fake` works. Never logged.
# ANTHROPIC_API_KEY=
# Claude model for summaries.
ANTHROPIC_MODEL=claude-opus-5-5
