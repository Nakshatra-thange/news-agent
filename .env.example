# Synergy configuration. Copy to .env and adjust: `cp .env.example .env`
# .env is git-ignored. Never commit real secrets.
# Format: plain KEY=value lines (no quotes, no `export`) so both the shell and
# the Makefile can read them.

# --- HTTP server ---
# Phase 1 has no authentication: keep the default loopback bind unless you
# understand the exposure.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# How long in-flight requests get to finish on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json (production) | text (human-friendly local dev)
LOG_FORMAT=text

# --- Added in later stages (not read yet) ---
# Stage 2: PostgreSQL connection string.
# DATABASE_URL=postgres://synergy:CHANGE_ME@localhost:5432/synergy?sslmode=disable
# Stage 5: optional GitHub token; raises search rate limits. No scopes needed.
# GITHUB_TOKEN=
